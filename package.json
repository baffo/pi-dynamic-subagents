{
  "name": "pi-dynamic-subagents",
  "version": "0.2.0",
  "description": "A Pi subagent dispatcher with per-agent fallback models.",
  "keywords": ["pi-package", "pi", "subagent", "subagents", "dynamic", "fallback", "agents"],
  "license": "MIT",
  "author": "baffo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baffo/pi-dynamic-subagents.git"
  },
  "bugs": {
    "url": "https://github.com/baffo/pi-dynamic-subagents/issues"
  },
  "homepage": "https://github.com/baffo/pi-dynamic-subagents#readme",
  "type": "module",
  "files": ["agents", "extensions", "README.md", "LICENSE"],
  "pi": {
    "extensions": ["./extensions/subagent.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.4",
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "tsx": "^4.21.0",
    "typebox": "^1.0.20",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "prepublishOnly": "npm run check && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
